# ===== 敏感信息（绝对不能进版本库）=====
.env

# ===== Python 运行环境与缓存 =====
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ===== IDE 配置（个人环境相关，不必进版本库）=====
.idea/
.vscode/

# ===== Office 临时锁文件（打开 xlsx 时自动生成）=====
~$*
.~lock.*

# ===== 程序生成的结果文件（每次运行都变，不进版本库）=====
批量测试结果.xlsx
测试结果.xlsx
*_测试结果.xlsx

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini
